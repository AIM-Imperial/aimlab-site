---
layout: layouts/page.njk
title: News
heading: "News & activities"
lede: >-
  Recent news, activity, achievements, and announcements from the group and its members.
---
{% for group in newsData.byYear %}
<div class="news-year">
  <h2 class="news-year__heading">{{ group.year }}</h2>
  <ul class="news-list news-list--full">
    {% for item in group.items %}
      <li class="news-list__item">
        <span class="news-list__date">{{ item.date | dateDisplay }}</span>
        <span class="news-list__body">{{ item.title | safe }}</span>
      </li>
    {% endfor %}
  </ul>
</div>
{% endfor %}
