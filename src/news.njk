---
layout: layouts/base.njk
forceMode: research
submenu: news
title: News
---
<section class="container page">
  <h1 class="page__title">News & activities</h1>
  <p class="page__lede">Recent news, activity, achievements, and announcements from the group and its members.</p>
  {% include "partials/page-submenu.njk" %}
  {% for group in newsData.byYear %}
  <div class="news-year">
    <h2 class="news-year__heading">{{ group.year }}</h2>
    <ul class="news-list news-list--full">
      {% for item in group.items %}
        <li class="news-list__item">
          <span class="news-list__date">{{ item.date | dateDisplay }}</span>
          <span class="news-list__body">{{ item.title | safe }}</span>
        </li>
      {% endfor %}
    </ul>
  </div>
  {% endfor %}
</section>
