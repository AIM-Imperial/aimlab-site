---
layout: layouts/base.njk
forceMode: research
title: Contact us
submenu: team
---
<section class="container page">
  <h1 class="page__title">Contact us</h1>
  <p class="page__lede">Contact the group by email, or visit us at Imperial's South Kensington campus.</p>
  {% include "partials/page-submenu.njk" %}
  <div class="contact-layout">
    <div class="contact-map">
      <iframe
        src="https://maps.google.com/maps?q=City%20and%20Guilds%20Building%2C%20Imperial%20College%20London%2C%20Exhibition%20Road%2C%20London%20SW7%202AZ&z=17&output=embed"
        title="Map showing the City and Guilds Building, Imperial College London"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
    </div>
    <div class="contact-side">
      <div class="contact-block">
        <div class="eyebrow">Get in touch</div>
        <p>General enquiries, collaboration, and prospective students:</p>
        <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
        <p>For opportunities to join us, see <a href="/join-us/">Join us</a>.</p>
      </div>
      <div class="contact-block">
        <div class="eyebrow">Find us</div>
        <p>
          {{ site.department }}<br>
          {{ site.institution }}<br>
          {{ site.address }}
        </p>
        <p><a href="https://www.imperial.ac.uk/visit/campuses/south-kensington/" class="ext">Directions to South Kensington</a></p>
        <p><a href="https://www.imperial.ac.uk/aeronautics/" class="ext">Department of Aeronautics</a></p>
      </div>
    </div>
  </div>
</section>
