---
layout: layouts/base.njk
homeDeck: true
---
{#
  Homepage: a full-screen panel deck of the lab's work. Mode-aware - Science
  shows research projects, Art shows the studio pieces. The shared site header
  floats over the imagery (and carries the mode tagline; see base.njk) and the
  deck is the scroll container (see body.is-deck styling and mode.js).
#}
{% macro deck(items, modifier, linkLabel) %}
<div class="deck deck--{{ modifier }}" aria-label="{{ modifier }} work, scroll to browse">
  {% for p in items %}
  <section class="deck__panel{% if loop.first %} deck__panel--first{% endif %}" style="background-image: url('{{ p.data.hero | heroLargeSrc }}')">
    {% set deckVideo = p.data.hero | heroDeckVideoSrc %}
    {% if deckVideo %}
      {# Only the first panel's clip downloads with the page. The others carry
         preload="none" and no autoplay; mode.js loads and plays each one as its
         panel comes within a screen of view, so ten clips do not compete for
         bandwidth on load. Without JS those panels show the still. #}
      <video class="deck__video" src="{{ deckVideo }}" poster="{{ p.data.hero | heroLargeSrc }}"
             muted loop playsinline aria-hidden="true"
             {% if loop.first %}autoplay preload="auto"{% else %}preload="none" data-deck-lazy{% endif %}></video>
    {% endif %}
    <div class="deck__text">
      <div class="deck__text-copy">
        <h2 class="deck__title"><a href="{{ p.url }}">{{ p.data.title }}</a></h2>
        {% if p.data.subtitle %}<p class="deck__subtitle">{{ p.data.subtitle }}</p>{% endif %}
      </div>
      <a class="deck__link" href="{{ p.url }}">{{ linkLabel }}</a>
      {% if loop.first %}<div class="deck__hint">Scroll</div>{% endif %}
    </div>
  </section>
  {% endfor %}
</div>
{% endmacro %}

{{ deck(collections.projects, "research", "View project") }}

{{ deck(collections.art, "gallery", "View piece") }}
