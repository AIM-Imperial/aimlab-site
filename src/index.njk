---
layout: layouts/base.njk
homeDeck: true
---
{#
  Homepage: a full-screen panel deck. The first panel is a title screen (the
  shared header centred on the page ground); then one panel per project, with
  its still and clip. Mode-aware - Science shows research projects, Art the
  studio pieces. The deck is the scroll container (body.is-deck; mode.js).
#}
{% macro deck(items, modifier, linkLabel) %}
<div class="deck deck--{{ modifier }}" aria-label="{{ modifier }} work, scroll to browse">
  {# Title panel. The fixed header (logo, name, menu) is centred over it by the
     CSS while the deck is at the top; the panel itself carries only the scroll
     hint. No media has to start here, which is what made the old first panel
     fragile in Safari. #}
  <section class="deck__panel deck__panel--intro" aria-label="Title">
    <div class="deck__hint">Scroll</div>
  </section>
  {% for p in items %}
  <section class="deck__panel">
    {% set still = p.data.hero | heroLargeSrc %}
    {% set deckVideo = p.data.hero | heroDeckVideoSrc %}
    {# The media: the still, and the clip stacked on it where the project has
       one (the still is then hidden by the CSS: the clip's poster is the same
       frame, and a translucent blend must not show both). Wide screens crop the
       media to fill the panel; narrow screens show its central square at full
       width on the page ground (see the CSS). #}
    <div class="deck__media{% if deckVideo %} deck__media--clip{% endif %}">
      <img class="deck__still" src="{{ still }}" alt="" aria-hidden="true" decoding="async">
      {% if deckVideo %}
        {# Every clip is preload="none" and carries no autoplay attribute in the
           markup. mode.js loads a clip when its panel is one screen away, marks
           it for autoplay so WebKit starts it as the panel arrives, and plays or
           pauses it as the panel enters or leaves the screen. Without JS the
           stills show. #}
        <video class="deck__video" src="{{ deckVideo }}" poster="{{ still }}"
               muted loop playsinline aria-hidden="true" preload="none" data-deck-lazy></video>
      {% endif %}
    </div>
    <div class="deck__text">
      <div class="deck__text-copy">
        <h2 class="deck__title"><a href="{{ p.url }}">{{ p.data.title }}</a></h2>
        {% if p.data.subtitle %}<p class="deck__subtitle">{{ p.data.subtitle }}</p>{% endif %}
      </div>
      <a class="deck__link" href="{{ p.url }}">{{ linkLabel }}</a>
    </div>
  </section>
  {% endfor %}
</div>
{% endmacro %}

{# The deck has no visible heading, so the page title is given to screen readers and search engines here. #}
<h1 class="visually-hidden">{{ site.fullName }} Laboratory, {{ site.department }}, {{ site.institution }}</h1>

{# collections.showcase = every project except those with `showcase: false`. #}
{{ deck(collections.showcase, "research", "View project") }}

{{ deck(collections.art, "gallery", "View piece") }}
