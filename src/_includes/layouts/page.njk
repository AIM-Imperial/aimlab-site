---
layout: layouts/base.njk
forceMode: research
---
{# Every interior page uses this layout. The header is drawn from front matter:
     title      page title, also the browser tab (required)
     heading    optional: the visible title when it differs from `title`
     lede       one or two sentences, centred under the title; HTML links allowed
     quote      optional: the page's opening statement, set as a quote block at
                the top of the content; HTML links allowed
     sections   optional list of on-page sections for the third-tier row: a
                heading's text (id derived from it) or { label, id }
     hero / heroAlt / heroCaption   optional full-width figure
     prose      optional: true/false forces the prose column on or off
     printSheet optional: the address of a printable one-page sheet; a
                "Print (PDF)" link then sits on its own line under the
                section row
   The pill row (pages of this section) comes from the folder's data file,
   which sets `submenu`. Markdown bodies are placed in the prose column;
   Nunjucks bodies are placed as written. With `sections`, a "Top" link and a
   rule are inserted before every listed section after the first, and a "Top"
   link closes the page; do not write them in the body. #}
<section class="container page" id="top">
  <header class="page__header">
    <h1 class="page__title">{{ heading or title }}</h1>
    {%- if lede %}
    <p class="page__lede">{{ lede | safe }}</p>
    {%- endif %}
  </header>
  {%- include "partials/page-submenu.njk" %}
  {%- if printSheet %}
  <div class="page__toolbar">
    {%- include "partials/page-sections.njk" %}
    <a class="page__print" href="{{ printSheet }}">Print (PDF)</a>
  </div>
  {%- else %}
  {%- include "partials/page-sections.njk" %}
  {%- endif %}
  {%- if quote %}
  <blockquote class="page__quote">{{ quote | safe }}</blockquote>
  {%- endif %}
  {%- if hero %}
    <figure class="page__hero">
      <div class="page__hero-media"><img src="{{ hero | heroSrc }}" alt="{{ heroAlt or title }}"></div>
      {% if heroCaption %}<figcaption>{{ heroCaption }}</figcaption>{% endif %}
    </figure>
  {%- endif %}
  {%- set isProse = prose if prose is defined else (page.inputPath | isMarkdown) %}
  {%- if isProse %}
  <div class="page__inner">
    <div class="page__body">
      {{ content | sectionDividers(sections) | safe }}
    </div>
  </div>
  {%- else %}
  {{ content | sectionDividers(sections) | safe }}
  {%- endif %}
</section>
