<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} - {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <link rel="icon" type="image/svg+xml" href="/assets/img/logo/favicon.svg">
  <link rel="stylesheet" href="/assets/css/site.css?v={{ buildTime }}">
  <meta property="og:title" content="{{ title or site.name }}">
  <meta property="og:description" content="{{ description or site.tagline }}">
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}/assets/img/og-image.jpg">
  <meta name="twitter:card" content="summary_large_image">
  <script>
    // Apply mode before paint to avoid a flash. Pages can force a mode
    // (art pages are always "gallery"); a ?mode= URL param (used by art tag
    // links) overrides and persists; otherwise use the visitor's saved choice.
    (function() {
      var forced = {% if forceMode %}"{{ forceMode }}"{% else %}null{% endif %};
      var param = null;
      try {
        param = new URLSearchParams(window.location.search).get("mode");
        if (param !== "gallery" && param !== "research") param = null;
      } catch (e) {}
      try {
        // TEMP: switch hidden - ignore saved/param mode so nobody is stuck in a
        // mode they can no longer leave. Art pages still force "gallery".
        // To re-enable, restore these two lines:
        // var m = forced || param || localStorage.getItem("aim-mode") || "research";
        // if (param && !forced) localStorage.setItem("aim-mode", param);
        var m = forced || "research";
        document.documentElement.setAttribute("data-mode", m);
      } catch (e) {
        document.documentElement.setAttribute("data-mode", forced || "research");
      }
    })();
  </script>
</head>
<body{% if homeDeck %} class="is-deck"{% endif %}>
  <header class="site-header{% if not homeDeck %} site-header--compact{% endif %}">
    <a class="wordmark" href="/">
      <span class="wordmark__logo">{% include "partials/aim-logo.njk" %}</span>
      <span class="wordmark__name">{{ site.fullName }}<span class="wordmark__suffix wordmark__suffix--lab"> Laboratory</span><span class="wordmark__suffix wordmark__suffix--studio"> Studio</span></span>
    </a>
    <div class="site-header__utility">
      {# TEMP: Science/Art switch hidden for now - uncomment to bring it back.
      <div class="mode-toggle" role="tablist" aria-label="View mode">
        <button class="mode-toggle__btn" data-mode="research" role="tab" aria-selected="true">Science</button>
        <button class="mode-toggle__btn" data-mode="gallery"  role="tab" aria-selected="false">Art</button>
      </div>
      #}
      <button class="menu-btn" aria-label="Menu" aria-expanded="false" aria-controls="site-menu">
        <span class="menu-btn__bar"></span>
        <span class="menu-btn__bar"></span>
        <span class="menu-btn__bar"></span>
      </button>
    </div>
    {# A page's submenu family also lights its parent nav item, so /press/
       highlights News and /contact/ highlights Team even though their URLs
       do not sit under the parent's path. #}
    {% set fam = site.submenus[submenu] if submenu else [] %}
    {% set famHrefs = [] %}
    {% for s in fam %}{% set _ = famHrefs.push(s.href) %}{% endfor %}
    {# The links come in two groups, the first half and the second half. The
       groups are invisible as such except in the compact header on wide
       screens, where they sit either side of the centred logo. #}
    {% macro menuLinks(items) %}
      {%- set half = (items.length / 2) | round(0, "ceil") %}
      {%- for group in [items.slice(0, half), items.slice(half)] %}
      <span class="site-menu__group site-menu__group--{{ "start" if loop.first else "end" }}">
        {%- for item in group %}
        <a href="{{ item.href }}" class="site-menu__link{% if page.url == item.href or (item.href != '/' and page.url and page.url.startsWith(item.href)) or famHrefs.includes(item.href) %} is-active{% endif %}">{{ item.label }}</a>
        {%- endfor %}
      </span>
      {%- endfor %}
    {% endmacro %}
    <nav class="site-menu site-menu--research" id="site-menu" aria-label="Main">
      {{ menuLinks(site.nav) }}
    </nav>
    <nav class="site-menu site-menu--gallery" id="site-menu-art" aria-label="Main (Art)">
      {{ menuLinks(site.navArt) }}
    </nav>
  </header>

  <main class="site-main">
    {{ content | safe }}
  </main>

  {% if not homeDeck %}
  <footer class="site-footer">
    <div class="rule" role="presentation"></div>
    <div class="site-footer__inner">
      <div class="site-footer__top">
        <div class="site-footer__brand">
          <span class="site-footer__logo">{% include "partials/aim-logo.njk" %}</span>
          <div class="site-footer__name">Architected Intelligent Matter</div>
          <div class="site-footer__social">
            {#- One icon per filled-in address in site.json, drawn from
                assets/img/icons/<key>.svg. #}
            {%- set socialLabels = { "github": "GitHub", "scholar": "Google Scholar", "bluesky": "Bluesky", "linkedin": "LinkedIn", "orcid": "ORCID", "instagram": "Instagram" } %}
            {%- for key, url in site.social %}{% if url %}
            <a href="{{ url }}" aria-label="{{ socialLabels[key] }}">{{ ("/assets/img/icons/" + key + ".svg") | inlineSvg | safe }}</a>
            {%- endif %}{% endfor %}
          </div>
        </div>

        <div class="site-footer__col site-footer__col--end">
          <a class="site-footer__imperial" href="https://www.imperial.ac.uk/aeronautics/" aria-label="Imperial College London, Department of Aeronautics">{{ "/assets/img/logo/imperial.svg" | inlineSvg("imperial-svg") | safe }}</a>

          <div class="site-footer__legal-text">
            {{ site.department }}<br>
            {{ site.institution }}<br>
            South Kensington Campus<br>
            London SW7 2AZ
          </div>

        </div>
      </div>
    </div>
  </footer>
  {% endif %}

  <script src="/assets/js/mode.js?v={{ buildTime }}"></script>
  <script src="/assets/js/frames.js?v={{ buildTime }}"></script>
</body>
</html>
