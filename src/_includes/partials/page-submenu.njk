{# Secondary menu under a page's lede. Pages opt in with front matter
   `submenu: <key>` where <key> names a list in site.json's "submenus".
   Every page in the family carries the same menu; the current page's
   pill is marked is-active. #}
{% if submenu and site.submenus[submenu] %}
<nav class="page-submenu" aria-label="Related pages">
  {% for item in site.submenus[submenu] %}
    <a class="link-pill{% if page.url == item.href %} is-active{% endif %}" href="{{ item.href }}">{{ item.label }}</a>
  {% endfor %}
</nav>
{% endif %}
