{# Shared body for project + art pages. Callers set `tagBase` (the tag-filter
   link root, e.g. "/research/" or "/gallery/") before including. #}
<header class="proj__header">
  <h1 class="proj__title">{{ title }}</h1>
  {% if subtitle %}<p class="proj__subtitle">{{ subtitle }}</p>{% endif %}
</header>

{% if tags or start or collaborators %}
<div class="proj__meta">
  {% if tags %}
    <div class="proj__meta-row">
      <div class="proj__meta-label">Tags</div>
      <div class="proj__meta-value">
        {% for t in tags %}<a class="proj__tag" data-tag="{{ t }}" href="{{ tagBase }}?tag={{ t | urlencode }}">{{ t }}</a>{% endfor %}
      </div>
    </div>
  {% endif %}
  {% if start %}
    <div class="proj__meta-row">
      <div class="proj__meta-label">Dates</div>
      <div class="proj__meta-value">{{ start }}{% if not end %}-present{% elif end != start %}-{{ end }}{% endif %}</div>
    </div>
  {% endif %}
  {% if collaborators %}
    <div class="proj__meta-row">
      <div class="proj__meta-label">Collaborators</div>
      <div class="proj__meta-value">{{ collaborators }}</div>
    </div>
  {% endif %}
</div>
{% endif %}

{% if hero %}
  {# A hero.mp4 in the image folder is used when present; otherwise the
     homepage deck video (hero-deck.mp4). The poster is hero-large.jpg, the
     video's first frame, so the page opens on the same still as before and the
     visitor starts playback with the native controls. #}
  {% set heroVideo = hero | heroVideoSrc %}
  {% if not heroVideo %}{% set heroVideo = hero | heroDeckVideoSrc %}{% endif %}
  <figure class="proj__hero">
    {% if heroVideo %}
      <video src="{{ heroVideo }}" poster="{{ hero | heroLargeSrc }}"
             controls muted loop playsinline preload="metadata"
             aria-label="{{ heroAlt or title }}"></video>
    {% else %}
      <img src="{{ hero | heroLargeSrc }}" alt="{{ heroAlt or title }}">
    {% endif %}
    {% if heroCaption %}<figcaption>{{ heroCaption }}</figcaption>{% endif %}
  </figure>
{% endif %}

<div class="proj__body">
  {{ content | safe }}
</div>

{% if links %}
  <div class="proj__links">
    {% for l in links %}
      <a href="{{ l.url }}" class="link-pill">{{ l.label }}</a>
    {% endfor %}
  </div>
{% endif %}

{% if publications %}
  <div class="proj__pubs">
    <h2 class="proj__pubs-heading">Related publications</h2>
    <ol class="pub-list">
      {% for p in publications %}
        <li class="pub">
          {% if p.authors %}<span class="pub__authors">{{ p.authors }}</span>{% endif %}
          <span class="pub__title">{{ p.title }}</span>
          {% if p.venue %}<span class="pub__venue">{{ p.venue | safe }}</span>{% endif %}
          {% if p.url %}<span class="pub__links"><a href="{{ p.url }}" target="_blank" rel="noopener">PDF</a></span>{% endif %}
        </li>
      {% endfor %}
    </ol>
  </div>
{% endif %}
